# Copy to .env.local and fill in. Never commit the real file. Never prefix these with NEXT_PUBLIC_.

# --- Chatbot (Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Any Flash or Flash-Lite model on the free tier works.
GEMINI_MODEL=

# --- Contact form (Resend) ---
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender. Must use a domain verified in Resend. Leave empty to use Resend's test
# sender (onboarding@resend.dev), which can only deliver to your own Resend account email.
RESEND_FROM="Aarambh Infinity <info@aarambhgrow.tech>"
# Inbox that receives enquiries. Defaults to the email in src/lib/site.ts.
CONTACT_TO_EMAIL=info@aarambhgrow.tech
